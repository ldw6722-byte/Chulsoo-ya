# Spring Boot + Supabase PostgreSQL
# 실제 값은 server/.env에만 저장하고 Git에 커밋하지 마세요.

SPRING_PROFILES_ACTIVE=supabase

# Supabase Dashboard → Project Settings → Database → Session pooler 권장
SUPABASE_DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
SUPABASE_SECRET_KEY=REPLACE_WITH_SUPABASE_SECRET_KEY
# Supabase JWT는 JWKS 공개키로 검증하므로 JWT secret을 저장하지 않습니다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 클라이언트 Vite 공개 환경변수 (anon key만 허용, service role 절대 금지)
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
